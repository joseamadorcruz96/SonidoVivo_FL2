# Plantilla de variables de entorno para el backend Sonido Vivo
# Copia este archivo como .env dentro de backend-springbot/ (ignorado por Git)

# Secreto HMAC-SHA256 compartido por 8081, 8082 y 8083 (minimo 32 caracteres)
JWT_SECRET=x9KomP2$vL8@nQ5!zR4&wT7*jH3^cB6%
JWT_EXPIRATION=86400000

# Secreto interno compartido entre ms-ventas-boletas (8083) y ms-catalogo-inventario (8082)
VENTAS_SERVICE_KEY=REEMPLAZA_CON_CLAVE_INTERNA_VENTAS_INVENTARIO

# URLs internas de los microservicios (para api-gateway y OpenFeign)
MS_USUARIOS_URL=http://localhost:8081
MS_CATALOGO_URL=http://localhost:8082
MS_INVENTARIO_URL=http://localhost:8082
MS_VENTAS_URL=http://localhost:8083

# Origenes permitidos por CORS en api-gateway (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuracion PostgreSQL para ms-catalogo-inventario (8082)
DB_URL=jdbc:postgresql://localhost:5432/sonidovivo_inventario
DB_USERNAME=postgres
DB_PASSWORD=REEMPLAZA_CON_TU_PASSWORD_POSTGRES
